{
	"name": "openchamber-deepshift",
	"version": "0.4.0",
	"private": true,
	"description": "DeepSeek peak/off-peak pricing panel for OpenChamber, plus the DeepShift OpenCode plugin in one install",
	"openchamber": {
		"apiVersion": 1,
		"engines": {
			"openchamber": ">=2.7.1"
		},
		"id": "deepshift",
		"name": "DeepShift",
		"icon": "timer",
		"contributes": {
			"panel": {
				"entry": "panel/index.html",
				"mobile": true
			},
			"page": true,
			"opencodePlugin": "plugin",
			"service": {
				"entry": "service/main.js",
				"runtime": "host",
				"keepRunning": true
			},
			"marks": true,
			"statusSection": {
				"source": {
					"path": "/status",
					"interval": 10000
				},
				"title": "DeepShift"
			}
		}
	},
	"dependencies": {
		"@openchamber/sdk": "^2.7.2"
	}
}
